      "explanation": "The bars at indexes 1 to 3 (heights 4, 5 and 3) hold a rectangle of height 3 and width 3."
    },
    {
      "input": "heights = [1, 8, 2]",
      "output": "8",
      "explanation": "The tall bar alone wins: any wider rectangle has to drop to height 2 or 1."
    }
  ],
