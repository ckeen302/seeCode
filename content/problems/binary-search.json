    {
      "input": "nums = [-7, -2, 0, 5, 11, 18, 26], target = 11",
      "output": "4",
      "explanation": "11 is at index 4. The first check lands on 5 at index 3, which is too small, so the whole left half is ruled out at once."
    },
    {
      "input": "nums = [3, 8, 14, 20], target = 10",
      "output": "-1",
      "explanation": "10 would sit between 8 and 14, but it isn't in the list."
    }
