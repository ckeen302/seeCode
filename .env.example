# SeeCode environment variables (Section 22.2 of docs/SPEC.md).
#
# Copy this file to `.env` in the repo root and fill in values:
#     cp .env.example .env
# `.env` is git-ignored. Never commit real keys. Both apps read the root `.env`
# in local development; hosted deploys (Vercel, Render) set these in their dashboards.
# Values left empty are treated as "not set".

# ---------------------------------------------------------------- web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase project URL and public anon (publishable) key. Leave empty until the
# Supabase project exists; the login page then offers only the dev user switcher.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pinned Pyodide release for the in-browser runner (set in M2).
NEXT_PUBLIC_PYODIDE_VERSION=

# Analytics and error reporting (M9).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=

# Shows the dev user switcher on /login. Local development only: leave unset in production.
NEXT_PUBLIC_AUTH_DEV_BYPASS=true

# ---------------------------------------------------------------- api (apps/api)
# development | production
ENV=development

# Local Postgres (docker compose or a local install). Placeholder credentials for local use only.
DATABASE_URL=postgresql+asyncpg://seecode:seecode@localhost:5432/seecode

# Supabase: project URL (used for the token issuer and JWKS), plus either the
# JWKS URL (asymmetric signing keys) or the legacy JWT secret (HS256).
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
# Only needed for account deletion (M6). Secret: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI features (M7). A small, fast, low-cost model.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
AI_DAILY_LIMIT=40

# Comma-separated list of web origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

SENTRY_DSN=

# Accept the X-Dev-User header instead of a Supabase token. Only honored when
# ENV=development; the API refuses to start if this is true with ENV=production.
AUTH_DEV_BYPASS=true
